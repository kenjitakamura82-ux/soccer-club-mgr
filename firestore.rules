rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // LIFF（LINEログイン）で入った人。api/liff-auth.js が発行するトークンに member と roles が入る
    function lineMember() { return signedIn() && request.auth.token.member == true; }
    function hasRole(r) { return lineMember() && r in request.auth.token.roles; }

    // 既存アプリ（匿名ログイン）が使っている場所。挙動は今まで通り
    match /artifacts/{appId}/users/{uid} {
      allow read, write: if signedIn();
    }
    match /artifacts/{appId}/public/data/{col}/{rest=**} {
      allow read, write: if signedIn() && col != 'studentPhotos';
    }

    // 子どもの顔写真はLINEで入ったメンバーだけ
    match /artifacts/{appId}/public/data/studentPhotos/{studentId} {
      allow read, write: if lineMember();
    }

    // メンバーと役割。役割を変えられるのは管理者だけ。本人は家族のひも付けと、はじめての準備の進み具合だけ変えられる
    match /artifacts/{appId}/members/{uid} {
      allow read: if lineMember();
      allow update: if hasRole('admin')
        || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentId', 'onboarding', 'updatedAt']));
    }

    // 設定（週末リマインドの曜日など）。読むのはメンバー、変えるのは管理者だけ
    match /artifacts/{appId}/settings/{docId} {
      allow read: if lineMember();
      // 入会の設定（年会費・ユニフォーム代・全体LINEの招待リンク）は会計と案内係も変えられる
      allow write: if hasRole('admin') || (docId == 'onboarding' && (hasRole('pay') || hasRole('guide')));
    }

    // 練習場の案内の画像など（スクリプトから入れる。読むのはメンバーだけ）
    match /artifacts/{appId}/liffContent/{docId} {
      allow read: if lineMember();
    }

    // 分析タブの記録。開いた記録は本人が1回だけ作れる。送った記録はメンバーが作る（週末リマインドは line-schedule-bot も書く）。読むのは管理者だけ
    match /artifacts/{appId}/opens/{id} {
      allow create: if lineMember() && request.resource.data.uid == request.auth.uid;
      allow read: if hasRole('admin');
    }
    match /artifacts/{appId}/sends/{id} {
      allow create, update: if lineMember();
      allow read: if hasRole('admin');
    }

    // line-schedule-bot の作業用（サーバーの管理者権限で読み書きするので、アプリからは触らせない）
    match /lineScheduleBot/{rest=**} {
      allow read, write: if false;
    }
  }
}
